set(_package_dir "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
set(_payload_files
    "PreyHFR.asi"
    "PreyHFR.ini"
    "PreyHFR-README.txt"
    "PreyHFR-LICENSE.txt"
)

set(_file_entries "")
foreach(_relative_path IN LISTS _payload_files)
    set(_path "${_package_dir}/${_relative_path}")
    if(NOT EXISTS "${_path}")
        message(FATAL_ERROR "Cannot create release manifest: missing ${_relative_path}")
    endif()
    file(SHA256 "${_path}" _sha256)
    if(_file_entries)
        string(APPEND _file_entries ",\n")
    endif()
    string(APPEND _file_entries
        "    {\"path\": \"${_relative_path}\", \"sha256\": \"${_sha256}\"}")
endforeach()

file(WRITE "${_package_dir}/PreyHFR-release.json"
"{\n"
"  \"manifest_format\": 2,\n"
"  \"name\": \"PreyHFR\",\n"
"  \"version\": \"@PREYHFR_PACKAGE_VERSION@\",\n"
"  \"target\": \"windows-x86\",\n"
"  \"compatibility\": {\n"
"    \"policy\": \"prey-1.4-x86-structural-v1\",\n"
"    \"tested_baseline_prey.exe_sha256\": \"cea6d424fbb8e2ffbf307a5bee509b45c2d35242f70be31387224db2a0eadd69\",\n"
"    \"tested_baseline_gamex86.dll_sha256\": \"74d436d376ba144762a28c940d0243135b4f9db8fdd7ee597b9cb5e4277b43c6\"\n"
"  },\n"
"  \"files\": [\n${_file_entries}\n  ]\n"
"}\n")
